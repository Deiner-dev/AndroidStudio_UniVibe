<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme in Night mode. -->
    <style name="Theme.UniVibe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorBrandMain</item>
        <item name="colorPrimaryVariant">@color/colorBrandMain</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/TurquesaVivo</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color and light status bar (black system icons) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
