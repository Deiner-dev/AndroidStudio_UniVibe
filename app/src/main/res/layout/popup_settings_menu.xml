<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="10dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <!-- Configuración -->
        <LinearLayout
            android:id="@+id/ll_menu_config"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/menu_configuration"
                android:src="@drawable/ic_engranaje"
                app:tint="@color/colorTextDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/menu_configuration"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Privacidad -->
        <LinearLayout
            android:id="@+id/ll_menu_privacy"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/menu_privacy"
                android:src="@android:drawable/ic_lock_idle_lock"
                app:tint="@color/colorTextDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/menu_privacy"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ayuda y soporte -->
        <LinearLayout
            android:id="@+id/ll_menu_help"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/menu_help_support"
                android:src="@android:drawable/ic_menu_help"
                app:tint="@color/colorTextDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/menu_help_support"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cerrar sesión -->
        <LinearLayout
            android:id="@+id/ll_menu_logout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/desc_logout"
                android:src="@android:drawable/ic_lock_power_off"
                app:tint="@color/colorTextDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/desc_logout"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
