<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundMain"
    tools:context=".SeguidoresSeguidosActivity">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/ll_top_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_back_followers"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_back"
            android:src="@drawable/ic_fecha_atras"
            app:tint="@color/colorTextDark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seguidores / Seguidos"
                android:textColor="@color/colorTextDark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conecta con la comunidad universitaria"
                android:textColor="@color/colorTextGrey"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Tabs Pill Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tabs_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="26dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/ll_top_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- Tab 1: Seguidores -->
            <LinearLayout
                android:id="@+id/ll_tab_seguidores"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_fab_green"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_icon_tab_seguidores"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Seguidores"
                    android:src="@drawable/ic_seguidor"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tv_title_tab_seguidores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Seguidores"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_count_tab_seguidores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_dot"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="128" />
            </LinearLayout>

            <!-- Tab 2: Seguidos -->
            <LinearLayout
                android:id="@+id/ll_tab_seguidos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_icon_tab_seguidos"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Seguidos"
                    android:src="@drawable/ic_siguiendo"
                    app:tint="@color/colorTextGrey" />

                <TextView
                    android:id="@+id/tv_title_tab_seguidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Seguidos"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_count_tab_seguidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_dot"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="76" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Search Box Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_search_box"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#F4F6F8"
        app:cardCornerRadius="23dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/card_tabs_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_search"
                android:src="@drawable/ic_buscar"
                app:tint="@color/colorTextGrey" />

            <EditText
                android:id="@+id/et_search_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Buscar usuarios..."
                android:inputType="text"
                android:textColor="@color/colorTextDark"
                android:textColorHint="@color/colorTextGrey"
                android:textSize="13sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Users RecyclerView & Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_search_box">

        <TextView
            android:id="@+id/tv_empty_users"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="No se encontraron usuarios"
            android:textColor="@color/colorTextGrey"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_users_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_usuario_seguimiento" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
