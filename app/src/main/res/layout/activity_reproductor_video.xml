<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ReproductorVideo">

    <!-- Video Area Container (VideoView or Thumbnail) -->
    <VideoView
        android:id="@+id/vv_video_player"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Video Poster Image Placeholder (if video is paused/loading) -->
    <ImageView
        android:id="@+id/iv_video_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/zonaarriba"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Overlay Gradient -->
    <View
        android:id="@+id/view_gradient_top"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_video_overlay_gradient_top"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Overlay Gradient -->
    <View
        android:id="@+id/view_gradient_bottom"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_video_overlay_gradient_bottom"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Top Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_video_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_back"
            android:src="@drawable/ic_fecha_atras"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_video_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/ib_video_options"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_options"
            android:src="@android:drawable/ic_menu_more"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Play/Pause Circular Overlay Button -->
    <FrameLayout
        android:id="@+id/fl_center_play_pause"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_circle_play_button"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_center_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Right Vertical Action Sidebar (Like, Comment, Save) -->
    <LinearLayout
        android:id="@+id/ll_right_actions"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/ll_progress_bar_container"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Like Star Button & Count -->
        <LinearLayout
            android:id="@+id/ll_action_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_action_like_star"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/label_likes"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="#FFC107" />

            <TextView
                android:id="@+id/tv_action_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="124"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Comment Button & Count -->
        <LinearLayout
            android:id="@+id/ll_action_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_action_comment"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/label_comments"
                android:src="@drawable/ic_comentarios"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_action_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="32"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bookmark / Save Button & Label -->
        <LinearLayout
            android:id="@+id/ll_action_bookmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_action_bookmark"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/label_saved"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_action_bookmark_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Guardar"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Left Content Info (User Info, Caption, Hashtag Chips) -->
    <LinearLayout
        android:id="@+id/ll_video_content_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/ll_progress_bar_container"
        app:layout_constraintEnd_toStartOf="@id/ll_right_actions"
        app:layout_constraintStart_toStartOf="parent">

        <!-- User Profile Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_video_user_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@drawable/logo"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_video_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UniVibe"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_verified_badge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/app_name"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="@color/TurquesaVivo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_video_user_handle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\@UniVibeOficial"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Caption / Description -->
        <TextView
            android:id="@+id/tv_video_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="La universidad se vive diferente 💚"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Hashtags Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_hashtag_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="#UniVibe"
                    android:textColor="#30D5C8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_hashtag_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="#VidaUniversitaria"
                    android:textColor="#30D5C8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hashtag_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="#Colombia"
                    android:textColor="#30D5C8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <!-- Bottom Video Controls (SeekBar + Play Pause + Time) -->
    <LinearLayout
        android:id="@+id/ll_progress_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@id/card_bottom_nav">

        <!-- Progress SeekBar -->
        <SeekBar
            android:id="@+id/sb_video_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:paddingHorizontal="0dp"
            android:progress="25"
            android:progressBackgroundTint="#66FFFFFF"
            android:progressTint="@color/TurquesaVivo"
            android:thumbTint="@color/TurquesaVivo" />

        <!-- Time & Controls Line -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/iv_control_play_pause"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="@string/app_name"
                android:focusable="true"
                android:src="@android:drawable/ic_media_pause"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_video_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/iv_control_play_pause"
                android:text="00:04 / 00:15"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_control_fullscreen"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="@string/app_name"
                android:focusable="true"
                android:src="@android:drawable/ic_menu_crop"
                app:tint="@color/white" />

        </RelativeLayout>

    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:cardBackgroundColor="#081E18"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Nav Inicio -->
            <LinearLayout
                android:id="@+id/ll_nav_inicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/ll_nav_buscar"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_inicio"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_home"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Nav Buscar -->
            <LinearLayout
                android:id="@+id/ll_nav_buscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/fl_nav_center"
                app:layout_constraintStart_toEndOf="@+id/ll_nav_inicio">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_search"
                    android:src="@drawable/ic_buscar"
                    app:tint="@color/colorTextGrey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_search"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Nav Center FAB -->
            <FrameLayout
                android:id="@+id/fl_nav_center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_nav_alertas"
                app:layout_constraintStart_toEndOf="@+id/ll_nav_buscar">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_fab_green" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/desc_add"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="@color/colorWhite" />
            </FrameLayout>

            <!-- Nav Alertas -->
            <LinearLayout
                android:id="@+id/ll_nav_alertas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/ll_nav_perfil"
                app:layout_constraintStart_toEndOf="@+id/fl_nav_center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_alerts"
                    android:src="@drawable/ic_notificacion"
                    app:tint="@color/colorTextGrey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_alerts"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Nav Perfil -->
            <LinearLayout
                android:id="@+id/ll_nav_perfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ll_nav_alertas">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_profile"
                    android:src="@drawable/ic_perfil"
                    app:tint="@color/colorTextGrey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_profile"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="10sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
