<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    tools:context=".llamadaVideo">

    <!-- Remote Video View (Fullscreen background) -->
    <io.livekit.android.renderer.TextureViewRenderer
        android:id="@+id/renderer_remoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Left Pill Widget (Logo, Name, Timer) -->
    <LinearLayout
        android:id="@+id/ll_video_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_video_call_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_video_pill_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_video_pill_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UniVibe"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_video_pill_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Llamando..."
                android:textColor="#A0B0A8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Right Action Buttons (Switch Camera, Grid/More) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_video_switch_camera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circle_play_button"
            android:contentDescription="@string/app_name"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/ib_video_grid_options"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_play_button"
            android:contentDescription="@string/app_name"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Top Right Floating Local Video View (PiP) -->
    <androidx.cardview.widget.CardView
        android:layout_width="110dp"
        android:layout_height="160dp"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <io.livekit.android.renderer.TextureViewRenderer
            android:id="@+id/renderer_local"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- Bottom Controls Bar (5 Buttons) -->
    <LinearLayout
        android:id="@+id/ll_video_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Mute Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_video_mute"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_play_button"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Silenciar"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Toggle Camera Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_video_toggle_cam"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_play_button"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Apagar video"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- End Call Button (Red) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_video_end"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_notification_badge"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Finalizar"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Participants Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_video_participants"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_play_button"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Participantes"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- More Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_video_more"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_play_button"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Más"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>