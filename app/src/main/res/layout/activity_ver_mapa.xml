<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Turquesa"
    tools:context=".VerMapaActivity">

    <!-- Header Toolbar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_map_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_back_map"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_back"
                android:src="@drawable/ic_fecha_atras"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorTextDark" />

            <TextView
                android:id="@+id/tv_map_toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Ubicación de la publicación"
                android:textColor="@color/colorTextDark"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_back_map"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Embedded OpenStreetMap WebView -->
    <WebView
        android:id="@+id/wv_open_street_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/card_location_info"
        app:layout_constraintTop_toBottomOf="@id/card_map_header" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pb_map_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/colorBrandMain"
        app:layout_constraintBottom_toBottomOf="@id/wv_open_street_map"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/wv_open_street_map" />

    <!-- Bottom Location Card Info -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_location_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/desc_location_icon"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#00A884" />

                <TextView
                    android:id="@+id/tv_location_name_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/colorTextDark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Universidad Popular del Cesar, Aguachica, Cesar" />
            </LinearLayout>

            <!-- Get Directions Button (Cómo llegar) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_get_directions"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_publish"
                android:text="Cómo llegar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:icon="@android:drawable/ic_menu_compass"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />

            <!-- Open in External Web/Maps Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_external_map"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Abrir navegación web (Google Maps / OSM)"
                android:textAllCaps="false"
                android:textColor="@color/colorBrandMain"
                android:textSize="14sp"
                android:visibility="gone"
                app:backgroundTint="@color/white"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_menu_mapmode"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/colorBrandMain"
                app:strokeColor="@color/colorBrandMain"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
