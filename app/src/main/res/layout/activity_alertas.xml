<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundMain"
    tools:context=".alertas">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_alertas_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/card_bottom_nav"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Top Header Area -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_header_alertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_medium">

                <ImageView
                    android:id="@+id/iv_logo_alertas"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/desc_logo"
                    android:src="@drawable/logo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/ll_greeting_alertas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_logo_alertas"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tv_greeting_alertas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorTextDark"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        tools:text="¡Hola, Deiner!" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_to_univibe"
                        android:textColor="@color/colorTextGrey"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/ib_chat_alertas"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_messages"
                    android:src="@drawable/ic_comentarios"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/colorTextDark" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Page Title Row (Back Button + Title + Subtitle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingVertical="8dp">

                <ImageButton
                    android:id="@+id/ib_back_alertas"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_back"
                    android:src="@drawable/ic_fecha_atras"
                    app:tint="@color/colorTextDark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alertas"
                        android:textColor="@color/colorTextDark"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aquí encuentras todas tus notificaciones"
                        android:textColor="@color/colorTextGrey"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Horizontal Filter Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Filter 1: Todas -->
                    <LinearLayout
                        android:id="@+id/ll_filter_todas"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_fab_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/iv_icon_todas"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_notificacion"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_text_todas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Todas"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_count_todas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_status_dot"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:textColor="#36A477"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="12" />
                    </LinearLayout>

                    <!-- Filter 2: Seguimientos -->
                    <LinearLayout
                        android:id="@+id/ll_filter_seguimientos"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tab_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/iv_icon_seguimientos"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="@color/colorTextGrey" />

                        <TextView
                            android:id="@+id/tv_text_seguimientos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Seguimientos"
                            android:textColor="@color/colorTextGrey"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_count_seguimientos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_status_dot"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:textColor="@color/colorTextGrey"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="3" />
                    </LinearLayout>

                    <!-- Filter 3: Me gusta -->
                    <LinearLayout
                        android:id="@+id/ll_filter_likes"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tab_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/iv_icon_likes"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="@color/colorTextGrey" />

                        <TextView
                            android:id="@+id/tv_text_likes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Me gusta"
                            android:textColor="@color/colorTextGrey"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_count_likes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_status_dot"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:textColor="@color/colorTextGrey"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="5" />
                    </LinearLayout>

                    <!-- Filter 4: Comentarios -->
                    <LinearLayout
                        android:id="@+id/ll_filter_comentarios"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_tab_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/iv_icon_comentarios"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_comentarios"
                            app:tint="@color/colorTextGrey" />

                        <TextView
                            android:id="@+id/tv_text_comentarios"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Comentarios"
                            android:textColor="@color/colorTextGrey"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_count_comentarios"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_status_dot"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:textColor="@color/colorTextGrey"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="4" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Notifications Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Empty State -->
                    <TextView
                        android:id="@+id/tv_empty_all_notifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="32dp"
                        android:text="No hay notificaciones en esta categoría"
                        android:textColor="@color/colorTextGrey"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <!-- RecyclerView for All Notifications -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_all_notifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_notificacion" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:cardBackgroundColor="@color/colorWhite"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/ll_nav_inicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/ll_nav_buscar"
                app:layout_constraintStart_toStartOf="parent">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_home"
                        android:src="@drawable/ic_inicio"
                        app:tint="@color/colorTextGrey" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_home"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_nav_buscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/fl_nav_center"
                app:layout_constraintStart_toEndOf="@id/ll_nav_inicio">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_search"
                        android:src="@drawable/ic_buscar"
                        app:tint="@color/colorTextGrey" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_search"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_nav_center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_nav_alertas"
                app:layout_constraintStart_toEndOf="@id/ll_nav_buscar">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_fab_green" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/desc_add"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="@color/colorWhite" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/ll_nav_alertas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/ll_nav_perfil"
                app:layout_constraintStart_toEndOf="@id/fl_nav_center">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_nav_selected_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_alerts"
                        android:src="@drawable/ic_notificacion"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_alerts"
                    android:textColor="@color/colorBrandMain"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_nav_perfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ll_nav_alertas">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_profile"
                        android:src="@drawable/ic_perfil"
                        app:tint="@color/colorTextGrey" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_profile"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="10sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
